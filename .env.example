# --- Immich (a regular user's API key; admin is NOT needed) ---
# Permissions: asset.upload, album.read, album.create, albumAsset.create
IMMICH_URL=http://192.168.1.50:2283
IMMICH_API_KEY=replace_with_your_immich_api_key
ALBUM_NAME=Family WhatsApp
DEVICE_ID=wa-family-bridge
IMMICH_TIMEOUT_MS=120000

# --- WhatsApp ---
# Leave empty on first start: the bridge logs your groups and their ids.
WHATSAPP_GROUP_ID=
# Max time for one WhatsApp Web call (first sync and long histories are slow)
WHATSAPP_TIMEOUT_MS=600000
# Import new messages as they arrive, including your own
WATCH_NEW_MESSAGES=true
MAX_MEDIA_MB=200

# --- History backfill ---
BACKFILL_ENABLED=true
# 0 = everything WhatsApp Web has synced; otherwise the newest N messages
BACKFILL_LIMIT=0
# Skip a completed scan on later restarts; false = rescan on every start
BACKFILL_ONCE=true
# Pause between media downloads, in milliseconds
BACKFILL_DELAY_MS=250
# History is imported right away, then the bridge follows WhatsApp's history sync and asks the
# phone for older batches. It stops once the phone has no older history and nothing new arrived
# for this long (0 = scan once only)
BACKFILL_SETTLE_MS=180000
# Stop following the sync after this long and continue on the next start (0 = no limit)
BACKFILL_MAX_WAIT_MS=0

# --- Uploads ---
# How often to retry failed uploads and check for resume, in milliseconds
UPLOAD_INTERVAL_MS=60000
# Attempts before a job is marked failed (re-queue with: cli retry-failed)
MAX_ATTEMPTS=8

# --- Run modes ---
# true = never write to Immich; uses separate state under DATA_DIR/dry-run
DRY_RUN=false
# true = backfill, drain the queue, then exit (no live watching)
RUN_ONCE=false
# whatsapp | fixtures (fixtures reads images from FIXTURES_DIR instead of WhatsApp)
MESSAGE_SOURCE=whatsapp
FIXTURES_DIR=

# --- Runtime ---
# Local runs default to ./data; the Docker image uses /data
# DATA_DIR=./data
# Local runs on macOS: path to Chrome, unless Puppeteer downloaded its own
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
